<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No launcher activity on purpose: a plugin lives inside PenLab's menus, not on the home screen. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_plugin"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- How PenLab finds this plugin: this action plus the manifest in res/raw/penlab_plugin.json. -->
        <service
            android:name=".SampleService"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.penlab.PLUGIN" />
            </intent-filter>
            <meta-data
                android:name="dev.penlab.plugin.manifest"
                android:resource="@raw/penlab_plugin" />
        </service>

        <!-- The "Hello screen" capability; exported so PenLab can start it, and it checks who did. -->
        <activity
            android:name=".HelloActivity"
            android:exported="true"
            android:label="@string/hello_label" />
    </application>

</manifest>
